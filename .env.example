# Copy to .env (gitignored) and fill in. Loaded by ./run_app.sh.

# Speaker labels in transcripts (optional). Create a Read token at
# https://huggingface.co/settings/tokens and accept the terms of
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Optional overrides (all variables: README > Configuration)
# CLAUDE_BIN=/path/to/claude
# CODEX_BIN=/path/to/codex
# PORT=8765
# LAN access for a trusted team (shared data, no user login):
# STORY_DNA_HOST=0.0.0.0
# Limit the server-side video picker to uploaded videos (relative to repo root):
# STORY_DNA_BROWSE_ROOTS=./data/input
# STORY_DNA_PARALLEL=4
# STORY_DNA_CODEX_PARALLEL=1
# STORY_DNA_CODEX_TIMEOUT=600
# STORY_DNA_BROWSE_ROOTS=/home/me
